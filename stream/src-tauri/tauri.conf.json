{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stream",
  "version": "0.2.27",
  "identifier": "com.marcelmarais.stream",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "backgroundColor": "#0c0e0d",
        "fullscreen": false,
        "height": 800,
        "hiddenTitle": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 12, "y": 20 },
        "width": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "entitlements": "entitlements.plist",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/marcelmarais/stream/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMTBCRjhCRkRBRDYyNTgKUldSWVlxMzlpNzhRNjF0QXBSR3VnUTRXY1pTemdYQWs5dmhVTVhsTXp3WDlRbm9VOFZsVTYyR2QK"
    },
    "process": {
      "all": true,
      "cmd": true,
      "sidecar": true
    }
  }
}
