# Copy to ~/.config/stream/release.env and run: chmod 600 ~/.config/stream/release.env
# Never commit the filled-in copy.

# The updater key whose public half is in tauri.conf.json. Installed apps
# reject updates signed with any other key.
UPDATER_KEY_PATH=
UPDATER_KEY_PASSWORD=

# Notarization: an App Store Connect API key (Users and Access > Integrations)
APPLE_API_ISSUER=
APPLE_API_KEY=
APPLE_API_KEY_PATH=

# Or an Apple ID with an app-specific password, instead of the three above
# APPLE_ID=
# APPLE_PASSWORD=
# APPLE_TEAM_ID=PD6ZLDT422
